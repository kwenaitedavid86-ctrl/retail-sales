  "datasets": [
    {
      "name": "5b93baca",
      "displayName": "Retail Sales Customer Transactions Summary Report",
      "queryLines": [
        "USE CATALOG `workspace`;\n",
        "USE SCHEMA `default`;\n",
        "\n",
        "SELECT COUNT(Distinct `Customer ID`) AS unique_customers, --counting different customer on the table\n",
        "\n",
        "    Date, \n",
        "\n",
        "    YEAR(Date) AS trans_year, --Extract thr year from the date colomn\n",
        "\n",
        "    MONTH(Date) AS trans_month, --Extract the month from the date colomn\n",
        "    MONTHNAME(Date) AS trans_month_name, --Extract the month name from the date colomn \n",
        "\n",
        "    DAY(Date) AS trans_day, --Extract the day from the date colomn\n",
        "    DAYNAME(Date) AS trans_day_name, --Extract the day from the date colomn\n",
        "\n",
        "    SUM(`Total Amount`) AS revenue, -- CAlcuted the total revenue\n",
        "\n",
        "    `Product Category`\n",
        "\n",
        "FROM test.schema.retail_sales_dataset\n",
        "GROUP BY ALL; -- Grouping my data based on all colomns that are not aggregated in my select statements"
      ]
    }
  ],
